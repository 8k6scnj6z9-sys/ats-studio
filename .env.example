# Public client-side variables
NEXT_PUBLIC_PORTAL_ANALYTICS_WEBSITE_ID=atstudio-pt
NEXT_PUBLIC_CONTACT_PHONE=

# Server-side variables (set at runtime in Coolify, never commit real values)
CONTACT_FROM_EMAIL="ATS Studio <noreply@atstudio.pt>"
RESEND_API_KEY=
PAGESPEED_API_KEY=

# CMS (/admin). Generate the hash with: node scripts/hash-admin-password.mjs
ADMIN_PASSWORD_HASH=
# At least 32 random characters, e.g. openssl rand -hex 32
ADMIN_SESSION_SECRET=
# Defaults to ./data locally; /data in the Docker image (persistent volume)
CMS_DB_PATH=
MEDIA_DIR=
